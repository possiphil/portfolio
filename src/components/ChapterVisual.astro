---
import { Image } from 'astro:assets';
import type { Chapter } from '../content/portfolio';
import Icon from './Icon.astro';

interface Props {
  chapter: Chapter;
}

const { media, pendingMedia } = Astro.props.chapter;
---

{media ? (
  <a class:list={['chapter-frame', { 'frame-illustration': media.kind === 'illustration' }]}
    href={media.image.src} target="_blank" rel="noopener" data-view-image aria-label={`Enlarge image: ${media.alt}`}>
    <Image src={media.image} alt={media.alt} widths={[360, 560, 800, 1040]}
      sizes="(max-width: 62rem) 90vw, 55vw" format="webp" quality={82}
      loading="lazy" decoding="async" />
    {media.kind === 'illustration' && <span class="asset-note">Concept illustration</span>}
    <span class="frame-expand"><Icon name="expand" /></span>
  </a>
) : (
  <div class="chapter-frame frame-pending">
    <div>
      <p class="eyebrow">Capture pending</p>
      <p>{pendingMedia ?? 'Project media'}</p>
    </div>
  </div>
)}
