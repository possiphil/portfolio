---
const icons = {
  'arrow-right': ['M4 12h15m-6-6 6 6-6 6'],
  'arrow-down': ['M12 4v15m-6-6 6 6 6-6'],
  'arrow-left': ['M20 12H5m6-6-6 6 6 6'],
  'arrow-up-right': ['M6 18 18 6M8 6h10v10'],
  'arrow-up': ['M12 20V5m-6 6 6-6 6 6'],
  sun: ['M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z', 'M12 2.5v2m0 15v2M2.5 12h2m15 0h2M5.28 5.28 6.7 6.7m10.6 10.6 1.42 1.42m0-13.44L17.3 6.7M6.7 17.3l-1.42 1.42'],
  moon: ['M20.4 15.6A8.8 8.8 0 0 1 8.4 3.6a8.8 8.8 0 1 0 12 12Z'],
  menu: ['M4 9h16M8 15h12'],
  close: ['m6 6 12 12M18 6 6 18'],
  expand: ['M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5'],
  plus: ['M5 12h14M12 5v14'],
  minus: ['M5 12h14'],
  'chevron-up': ['m6 15 6-6 6 6'],
  play: ['M8 5v14l11-7Z'],
  pause: ['M9 5v14m6-14v14'],
} as const;

interface Props {
  name: keyof typeof icons;
}

const { name } = Astro.props;
---

<svg class:list={['icon', `icon-${name}`]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icons[name].map((path) => <path d={path} />)}
</svg>
