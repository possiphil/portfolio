---
import { illustrativeGenix } from '../../lib/genix-explorer/illustrative';
import { levels } from '../../lib/genix-explorer/model';

const depth = String(levels.length).padStart(2, '0');
---

<div class="gx-app" data-genix-explorer>
  <a class="gx-skip" href="#genix-viewport">Skip to scene</a>

  <header class="gx-topbar">
    <div class="gx-brand">
      <span class="gx-brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
          <path d="m12 3-9 5 9 5 9-5-9-5ZM3 12l9 5 9-5M3 16l9 5 9-5"></path>
        </svg>
      </span>
      <span class="gx-brand__name">Genix</span>
      <span class="gx-brand__label">Architecture explorer</span>
    </div>
    <div class="gx-topbar__actions">
      <span class="gx-provenance" title="The architecture and C# are illustrative content.">
        <span aria-hidden="true"></span> Illustrative model
      </span>
      <a class="gx-exit" href="/#main" data-exit aria-label="Exit explorer" title="Exit explorer (Escape)">
        <span>Exit</span>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.35" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15"></path>
        </svg>
      </a>
    </div>
  </header>

  <main class="gx-main">
    <div class="gx-intro">
      <nav class="gx-crumbs" aria-label="Scene path">
        <ol data-breadcrumbs>
          <li data-crumb="overview"><button type="button" data-go="overview" aria-current="location">Overview</button></li>
        </ol>
      </nav>
      <h1 class="gx-title"><span data-title>{illustrativeGenix.title}</span><span aria-hidden="true">.</span></h1>
      <div class="gx-depth">
        <span class="gx-depth__label" aria-hidden="true">Depth</span>
        <div class="gx-depth__meter" data-depth-meter role="img" aria-label={`Depth 1 of ${levels.length}`}>
          {levels.map((_, index) => <span data-reached={index === 0 ? '' : undefined}></span>)}
        </div>
        <span class="gx-depth__number" aria-hidden="true"><b data-depth>01</b><span> / {depth}</span></span>
      </div>
      <p class="gx-description" data-description>{illustrativeGenix.description}</p>
    </div>

    <section class="gx-stage" aria-label="Semantic zoom canvas">
      <div class="gx-viewport" id="genix-viewport" data-viewport tabindex="0" role="region" aria-label="Exploration viewport" aria-describedby="genix-instructions">
        <div class="gx-world" data-world></div>
        <noscript><p class="gx-noscript">Enable JavaScript to explore the interactive model.</p></noscript>
      </div>
      <div class="gx-stage__toolbar">
        <p class="gx-legend">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <path d="M3 8V3h5m4 0h5v5m0 4v5h-5m-4 0H3v-5m4-2h6m-3-3v6"></path>
          </svg>
          <span data-legend>Request flow</span>
        </p>
        <button class="gx-reset" type="button" data-reset aria-label="Return to overview" title="Return to overview (Home)">
          <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="3" y="3" width="14" height="14" rx="2"></rect><path d="M10 3v14M3 10h14"></path>
          </svg>
          Overview
        </button>
      </div>
      <p class="gx-stage__hint"><span data-stage-hint>Select a region or zoom into it</span></p>
    </section>

    <div class="gx-controls">
      <label class="gx-scroll">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
          <rect x="5.25" y="2.75" width="9.5" height="14.5" rx="4.75"></rect><path d="M10 5.5v4"></path>
        </svg>
        Scroll
        <span class="gx-select">
          <select data-scroll-mode aria-label="Scroll behavior">
            <option value="auto">Auto</option>
            <option value="pan">Pan</option>
            <option value="zoom">Zoom</option>
          </select>
        </span>
      </label>
      <p class="gx-controls__hint">Drag to pan<i aria-hidden="true">·</i><span data-zoom-hint>Wheel or pinch to zoom</span></p>
      <div class="gx-zoom" role="group" aria-label="Zoom controls">
        <button type="button" data-zoom-out aria-label="Zoom out" title="Zoom out (−)">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 10h12"></path></svg>
        </button>
        <span class="gx-magnification" data-magnification>1.0×</span>
        <button type="button" data-zoom-in aria-label="Zoom in" title="Zoom in (+)">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 10h12m-6-6v12"></path></svg>
        </button>
      </div>
    </div>

    <p class="gx-visually-hidden" id="genix-instructions">
      Drag to pan and scroll or pinch to zoom. You can change scroll behavior below the scene.
      With the viewport focused, use arrow keys to pan, plus and minus to zoom, Enter to explore the highlighted region,
      Backspace to go up a level, Home to reset, and Escape to exit. Tab moves between controls and visible regions.
    </p>
    <p class="gx-visually-hidden" role="status" data-status></p>
  </main>
</div>

<script>
  import '../../lib/genix-explorer/explorer';
</script>
