---
import { Image } from 'astro:assets';
import terrain from '../assets/terrain-study.webp';
import type { projects } from '../content/portfolio';

interface Props {
  project: (typeof projects)[number];
}

const { project } = Astro.props;
---

<article class:list={['project', { 'project-featured': project.id === 'genix' }]} id={project.id} aria-labelledby={`${project.id}-title`}>
  {project.id === 'genix' && (
    <figure class="project-figure">
      <Image
        src={terrain}
        alt="A layered topographic study of a mountain ridge"
        widths={[420, 680, 1040]}
        sizes="(max-width: 49rem) calc(100vw - 2.5rem), (max-width: 85rem) 45vw, 35rem"
        format="webp"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Procedural terrain · Concept illustration</figcaption>
    </figure>
  )}
  <div class="project-copy">
    <p class="project-context">{project.context}</p>
    <h3 class="display-heading" id={`${project.id}-title`}>{project.name}</h3>
    <p class="project-title">{project.title}</p>
    <p class="project-description">{project.description}</p>
    <dl class="details">
      {project.details.map(({ label, value }) => (
        <div><dt>{label}</dt><dd>{value}</dd></div>
      ))}
    </dl>
    {project.url && <a class="text-link" href={project.url}>Explore {project.name}</a>}
  </div>
</article>
