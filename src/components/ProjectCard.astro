---
import type { Project } from '../content/portfolio';
import Icon from './Icon.astro';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  project: Project;
  next?: boolean;
}

const { project, next = false } = Astro.props;
const titleId = `card-${project.id}`;
const note = project.cover?.kind === 'illustration' ? 'Concept illustration' : undefined;
const descriptionIds = [project.category && `${titleId}-category`, note && `${titleId}-media`].filter(Boolean).join(' ');
---

<article class:list={['project-card', { 'next-card': next }]} data-slot={project.slot}>
  {project.study ? (
    <div class="card-surface card-ready">
      <ProjectMedia media={project.cover} transition={!next ? project.id : undefined}
        sizes="(max-width: 52rem) 92vw, 58vw" gallery={!next}
        priority={!next && project.slot === 'featured' ? 'low' : undefined} />
      {note && <span class="asset-note" id={`${titleId}-media`}>{note}</span>}
      <div class="card-copy">
        {project.category && <p class="card-meta" id={`${titleId}-category`}>{project.category}</p>}
        <h3 id={titleId}>
          <a class="card-link" href={`/work/${project.id}`} aria-describedby={descriptionIds || undefined}
            data-project-link={!next ? project.id : undefined}>{project.name}</a>
        </h3>
      </div>
      <span class="card-arrow"><Icon name="arrow-up-right" /></span>
    </div>
  ) : (
    <div class="card-surface card-pending">
      <div class="card-copy">
        <p class="card-meta">Case study pending</p>
        <h3 id={titleId}>{project.name}</h3>
      </div>
    </div>
  )}
  {!next && project.study && project.cover?.video && (
    <button type="button" class="icon-button preview-toggle" aria-label="Pause preview" data-loop-toggle hidden>
      <Icon name="pause" /><Icon name="play" />
    </button>
  )}
</article>
