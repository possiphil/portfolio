---
/**
 * Long-form page: a header row (image tile + title + intro in two columns),
 * then a paper card with drop cap and ornaments, and a sticky side column
 * with a table of contents, facts and links.
 */
import { Image } from 'astro:assets';
import Card from './Card.astro';
import PageHeading from './PageHeading.astro';
import type { ProjectMedia } from '../content/media';

interface Section {
  heading: string;
  paragraphs: string[];
  media?: ProjectMedia;
  code?: string;
}

interface Props {
  title: string;
  trail?: { label: string; href: string }[];
  cover: ProjectMedia;
  intro: string;
  sections: Section[];
  facts?: { label: string; value: string }[];
  links?: { label: string; href: string }[];
  outcomes?: string[];
}

const { title, trail, cover, intro, sections, facts = [], links = [], outcomes = [] } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<article class="article">
  <header class="article-head">
    <Card class="article-cover" tilt={5} index={0} tone="dark">
      <div class="article-cover-image" data-parallax="10">
        <Image src={cover.image} alt={cover.alt} widths={[360, 640]} sizes="(min-width: 900px) 260px, 60vw" loading="eager" />
      </div>
    </Card>
    <div class="article-head-text reveal" style="--i:1">
      <PageHeading title={title} trail={trail} />
      <p class:list={['article-intro', { 'is-long': intro.length > 280 }]}>{intro}</p>
      <button class="share" type="button" data-share>copy link to this page</button>
    </div>
  </header>

  <div class="article-body">
    <div class="paper reveal" style="--i:2">
      {
        sections.map((section, s) => (
          <section id={slug(section.heading)}>
            {s > 0 && (
              <div class="ornament" aria-hidden="true">
                <span />·&nbsp;&nbsp;{section.heading}&nbsp;&nbsp;·<span />
              </div>
            )}
            <h2 class:list={{ 'visually-hidden': s > 0 }}>{section.heading}</h2>
            {section.paragraphs.map((p, i) => (
              <p class:list={{ 'drop-cap': s === 0 && i === 0 }}>{p}</p>
            ))}
            {section.code && (
              <pre class="code"><code>{section.code}</code></pre>
            )}
            {section.media && (
              <figure>
                <Image src={section.media.image} alt={section.media.alt} widths={[600, 1000]} sizes="(min-width: 900px) 560px, 100vw" />
                <figcaption>{section.media.alt}</figcaption>
              </figure>
            )}
          </section>
        ))
      }

      {
        outcomes.length > 0 && (
          <section id="outcomes">
            <div class="ornament" aria-hidden="true">
              <span />·&nbsp;&nbsp;Outcomes&nbsp;&nbsp;·<span />
            </div>
            <h2 class="visually-hidden">Outcomes</h2>
            <ul class="outcomes">
              {outcomes.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="article-aside reveal" style="--i:3">
      <div class="aside-sticky">
        <nav class="toc" aria-label="On this page">
          {sections.map((section) => <a href={`#${slug(section.heading)}`}>— {section.heading}</a>)}
          {outcomes.length > 0 && <a href="#outcomes">— Outcomes</a>}
        </nav>

        {
          facts.length > 0 && (
            <dl class="facts">
              {facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          links.length > 0 && (
            <Card class="aside-links" tilt={6} index={4}>
              <ul>
                {links.map((link) => (
                  <li>
                    <a href={link.href} rel="noopener" target="_blank">
                      <strong>{link.label}</strong>
                      <span>{link.href.replace(/^https?:\/\/(www\.)?/, '').split('/').slice(0, 3).join('/')}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </Card>
          )
        }
      </div>
    </aside>
  </div>
</article>
