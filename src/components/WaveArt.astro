---
/**
 * Abstract gradient waves drawn as SVG, so tiles stay crisp at any size and
 * colours come straight from the palette in src/content/site.ts.
 * `variant` picks one of five wave shapes; each drifts slowly on its own.
 */
import type { Palette } from '../content/site';

interface Props {
  palette: Palette;
  variant?: number;
}

const { palette, variant = 0 } = Astro.props;
const id = `w${Math.random().toString(36).slice(2, 8)}`;

const waves = [
  // Gentle swell across the lower half.
  { wave: 'M-60 128 C 0 100, 50 150, 110 124 S 210 92, 280 112 L280 280 L-60 280 Z', crest: '' },
  // High ridge with a dip in the middle.
  { wave: 'M-60 96 C -10 70, 40 120, 100 108 S 200 70, 280 92 L280 280 L-60 280 Z', crest: '' },
  // Diagonal sweep from the top right, with a crest in the corner.
  {
    wave: 'M-60 170 C 10 150, 60 70, 130 60 S 230 -10, 280 -20 L280 280 L-60 280 Z',
    crest: 'M120 -40 C 150 10, 190 40, 280 50 L280 -40 Z',
  },
  // Layered bands, like a dune.
  {
    wave: 'M-60 110 C 10 80, 90 150, 160 118 S 240 96, 280 104 L280 280 L-60 280 Z',
    crest: 'M-60 40 C 20 70, 120 -10, 280 30 L280 -40 L-60 -40 Z',
  },
  // Rising slope with a soft lip.
  {
    wave: 'M-60 70 C 30 60, 90 110, 150 90 S 240 60, 280 66 L280 280 L-60 280 Z',
    crest: 'M-60 160 C 20 140, 100 200, 280 170 L280 280 L-60 280 Z',
  },
];
const shape = waves[variant % waves.length];
---

<svg class="wave-art" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" style={`--drift-delay:${variant * -3.7}s`}>
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={palette.from} />
      <stop offset="1" stop-color={palette.to} />
    </linearGradient>
    <linearGradient id={`${id}-wave`} x1="0" y1="0" x2="1" y2="0.6">
      <stop offset="0" stop-color={palette.wave[0]} />
      <stop offset="1" stop-color={palette.wave[1]} />
    </linearGradient>
    {
      palette.crest && (
        <linearGradient id={`${id}-crest`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color={palette.crest[0]} />
          <stop offset="1" stop-color={palette.crest[1]} />
        </linearGradient>
      )
    }
  </defs>
  <rect x="-60" y="-60" width="320" height="320" fill={`url(#${id}-bg)`} />
  {shape.crest && <path class="wave-crest" d={shape.crest} fill={palette.crest ? `url(#${id}-crest)` : palette.wave[0]} opacity={palette.crest ? 1 : 0.55} />}
  <path class="wave-main" d={shape.wave} fill={`url(#${id}-wave)`} />
</svg>
