---
import { Image } from 'astro:assets';
import { about } from '../content/variant';
import VariantLayout from '../layouts/VariantLayout.astro';
---

<VariantLayout title="About" label="About" active="about" navTone="dark" footer="full">
  <header class="page-header container-medium">
    <h1 class="page-heading">{about.heading.map((line) => <span class="line-mask"><span>{line}</span></span>)}</h1>
  </header>

  <main>
    <section class="line-globe container-medium">
      <span class="stripe" data-reveal></span>
      <div class="digital-ball" data-parallax-ball aria-hidden="true">
        <div class="globe">
          <span class="globe-circle"></span>
          <span class="globe-circle"></span>
          <span class="globe-circle"></span>
          <span class="globe-hor"></span>
          <span class="globe-hor-middle"></span>
        </div>
      </div>
    </section>

    <section class="about-image">
      <div class="bottom-lightgray"></div>
      <div class="container about-image-grid">
        <div class="about-image-copy" data-reveal>
          <svg class="about-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M6 6l12 12M18 8v10H8" /></svg>
          <p>{about.paragraph}</p>
          <p class="animate-dots">{about.exploring}<span>.</span><span>.</span><span>.</span></p>
        </div>
        <div class="about-photo" data-parallax-image>
          <Image src={about.image} alt={about.imageAlt} widths={[600, 1000]} sizes="(max-width: 800px) 90vw, 55vw" format="webp" quality={86} />
        </div>
      </div>
    </section>

    <section class="about-services">
      <div class="container">
        <h2 class="animate-dots" data-reveal>{about.servicesHeading}<span>.</span><span>.</span><span>.</span></h2>
        <div class="services-grid">
          {about.services.map((service, index) => (
            <div class="service" data-reveal>
              <p class="eyebrow">{String(index + 1).padStart(2, '0')}</p>
              <span class="stripe"></span>
              <h4>{service.title}</h4>
              <p>{service.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="about-highlight container-medium">
      <div class="about-highlight-image" data-parallax-image>
        <Image src={about.highlight.image} alt={about.highlight.imageAlt} widths={[500, 900]} sizes="(max-width: 800px) 90vw, 35vw" format="webp" />
      </div>
      <div class="about-highlight-copy" data-reveal>
        <div class="badge" aria-hidden="true">{about.highlight.badge}</div>
        <h2>{about.highlight.heading.map((line) => <span>{line}</span>)}</h2>
        <p>{about.highlight.text}</p>
      </div>
    </section>
  </main>
</VariantLayout>
