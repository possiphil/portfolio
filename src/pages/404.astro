---
import VariantLayout from '../layouts/VariantLayout.astro';
---

<VariantLayout title="Page not found" label="404" active="none" navTone="dark" footer="full" description="This page could not be found.">
  <header class="page-header container-medium">
    <p class="eyebrow">404</p>
    <h1 class="page-heading">
      <span class="line-mask"><span>This page took a</span></span>
      <span class="line-mask"><span>wrong turn</span></span>
    </h1>
  </header>
  <main>
    <div class="center-button container not-found-button">
      <a class="pill-button pill-button-solid magnetic" href="/" data-magnetic>
        <span class="btn-fill"></span>
        <span class="magnetic-inner">Back to home</span>
      </a>
    </div>
  </main>
</VariantLayout>
