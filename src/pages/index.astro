---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { contact, media } from '../content/media';
import { fullName, portfolio, projects } from '../content/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const words = portfolio.about.statement.split(' ');
const emphasisStart = words.length - portfolio.about.emphasis.split(' ').length;
---

<BaseLayout>
  <div class="entry-curtain" aria-hidden="true"><span>PS<i>.</i></span></div>

  <main id="main" tabindex="-1">
    <div class="arrival">
      <section class="hero" aria-labelledby="intro-heading" data-hero>
        <figure class="hero-portrait">
          <div class="portrait-depth">
            <Image src={media.portrait.image} alt={media.portrait.alt}
              widths={[360, 560, 800, 1000]} sizes="(max-width: 52rem) 100vw, 65vw"
              format="webp" quality={86} loading="eager" fetchpriority="high" />
          </div>
        </figure>
        <div class="hero-layout shell">
          <div class="hero-copy">
            <p class="eyebrow hero-role">{portfolio.role}</p>
            <h1 class="hero-name" id="intro-heading">
              <span class="name-first"><span>{portfolio.firstName}</span></span>
              <span class="name-last"><span>{portfolio.lastName}</span></span>
            </h1>
            <div class="hero-lede">
              <p>{portfolio.introduction}</p>
              <a class="editorial-link explore-link" href="#work" data-scroll-link>Explore work <Icon name="arrow-down" /></a>
            </div>
          </div>
        </div>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-heading" tabindex="-1">
        <div class="shell">
          <h2 class="display-heading" id="work-heading">Selected <em>work</em></h2>
          <div class="work-grid" data-reveal-group>
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </div>
      </section>
    </div>

    <section class="about-section" id="about" aria-labelledby="about-heading" tabindex="-1">
      <div class="shell section-layout">
        <p class="eyebrow section-kicker">About</p>
        <div>
          <h2 class="about-heading display-heading" id="about-heading" aria-label={portfolio.about.statement} data-reveal-group>
            {words.map((word, index) => (
              <Fragment><span class:list={['about-word', { emphasize: index >= emphasisStart }]}
                style={{ '--reveal-order': index }} aria-hidden="true">{word}</span>{' '}</Fragment>
            ))}
          </h2>
          <p class="about-copy">{portfolio.about.paragraph}</p>
          <dl class="toolkit">
            {portfolio.technicalAreas.map(({ label, items }) => (
              <div>
                <dt>{label}</dt>
                <dd><ul role="list">{items.map((item) => <li>{item}</li>)}</ul></dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="education-section shell section-layout" id="education" aria-labelledby="education-heading">
      <div>
        <h2 class="eyebrow section-kicker" id="education-heading">Education</h2>
      </div>
      <ol class="timeline" data-timeline role="list">
        {portfolio.education.map(({ degree, institutions, program, date, dateTime }) => (
          <li data-milestone>
            <span class="timeline-dot" aria-hidden="true"></span>
            <div class="milestone-copy">
              {dateTime
                ? <time class="eyebrow" datetime={dateTime}>{date}</time>
                : <p class="eyebrow">{date}</p>}
              <h3>{degree}</h3>
              {program && <p class="program">{program}</p>}
              <p class="institutions">{institutions}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-heading" tabindex="-1">
      <div class="contact-layout shell">
        <p class="eyebrow">Contact</p>
        <h2 class="display-heading" id="contact-heading">{portfolio.contact}</h2>
        <div class="contact-primary">
          {contact.email
            ? <a class="copper-pill" href={`mailto:${contact.email}`}>Email me</a>
            : <button class="copper-pill" type="button" disabled aria-describedby="email-status">Email me</button>}
          {!contact.email && <p class="pending-note" id="email-status">Email address pending</p>}
        </div>
        <div class="contact-links">
          <a class="editorial-link" href={contact.github}>GitHub <Icon name="arrow-up-right" /></a>
          <span aria-hidden="true">·</span>
          {contact.linkedin
            ? <a class="editorial-link" href={contact.linkedin}>LinkedIn <Icon name="arrow-up-right" /></a>
            : <span class="editorial-link pending" role="link" aria-disabled="true" title="LinkedIn URL pending">LinkedIn <Icon name="arrow-up-right" /><span class="sr-only"> (URL pending)</span></span>}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>{fullName}</span>
    <a class="editorial-link" href="/" data-home>Back to top <Icon name="arrow-up" /></a>
  </footer>

  <script>
    import '../scripts/home';
  </script>
</BaseLayout>
