---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import engraving from '../assets/engraving.webp?url';
import italicFont from '../assets/fonts/instrument-serif-italic.woff2?url';
import GitHubMark from '../components/GitHubMark.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { fullName, portfolio, projects } from '../content/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

const portraits = import.meta.glob<ImageMetadata>('../assets/portrait.webp', {
  eager: true,
  import: 'default',
});
const portrait = portraits['../assets/portrait.webp'];

const navigation = [
  { id: 'top', label: 'Home' },
  { id: 'about', label: 'About' },
  { id: 'work', label: 'Projects' },
  { id: 'background', label: 'Education' },
  { id: 'contact', label: 'Contact' },
];
---

<BaseLayout intro>
  <link slot="preload" rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin="anonymous" />
  <link slot="preload" rel="preload" href={engraving} as="image" />
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="header-inner shell">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true">{portfolio.initials}</span>
        <span>sanktjohanser.dev</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul role="list">
          {navigation.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Light mode" aria-pressed="false" data-theme-toggle hidden>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <path d="M20.5 15.3A8.7 8.7 0 0 1 8.7 3.5 8.8 8.8 0 1 0 20.5 15.3Z" stroke-linejoin="round" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2m0 15v2M2.5 12h2m15 0h2M5.3 5.3l1.4 1.4m10.6 10.6 1.4 1.4m0-13.4-1.4 1.4M6.7 17.3l-1.4 1.4" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero shell" aria-labelledby="intro-heading">
      <div class="hero-identity">
        <p class="section-label">{portfolio.role}</p>
        <h1 class="hero-name" id="intro-heading">
          <span class="name-first"><span>{portfolio.firstName}</span></span>
          <span class="name-last"><span>{portfolio.lastName}</span></span>
        </h1>
      </div>

      <div class="hero-art" aria-hidden="true" style={`--engraving: url("${engraving}")`}>
        <div class="hero-engraving"></div>
      </div>

      <div class="hero-details">
        <p class="hero-intro">{portfolio.introduction}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">View projects</a>
          <a class="text-link" href={portfolio.github.url}><GitHubMark /> GitHub</a>
        </div>
      </div>
    </section>

    <section class="section shell about" id="about" aria-labelledby="about-heading">
      <div class="about-copy">
        <p class="section-label">About</p>
        <h2 class="display-heading" id="about-heading">{portfolio.about.heading}</h2>
        <div class="prose">
          {portfolio.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      {portrait && (
        <figure class="portrait">
          <Image
            src={portrait}
            alt={`Portrait of ${fullName}`}
            width={640}
            widths={[288, 480, 640]}
            sizes="(max-width: 49rem) 224px, 288px"
            format="webp"
            quality={86}
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
    </section>

    <section class="section projects-section" id="work" aria-labelledby="work-heading">
      <div class="shell">
        <h2 class="section-label" id="work-heading">Projects</h2>
        <div class="project-list">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>

    <section class="section shell education" id="background" aria-labelledby="education-heading">
      <div>
        <h2 class="display-heading" id="education-heading">Education</h2>
        <ul class="education-list" role="list">
          {portfolio.education.map(({ degree, institutions, program, date, dateTime }) => (
            <li>
              <h3>{degree}</h3>
              <time datetime={dateTime}>{date}</time>
              <div class="education-description">
                {program && <p>{program}</p>}
                <p>{institutions}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="technical">
        <h3 class="section-label">Technical areas</h3>
        <dl class="details">
          {portfolio.technicalAreas.map(({ label, value }) => (
            <div><dt>{label}</dt><dd>{value}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="contact shell" id="contact" aria-labelledby="contact-heading">
      <div class="contact-panel">
        <div>
          <p class="section-label">Contact</p>
          <h2 class="display-heading" id="contact-heading">Find me on GitHub.</h2>
          <p>{portfolio.contact}</p>
        </div>
        <a class="button contact-button" href={portfolio.github.url}>
          <GitHubMark /><span>@{portfolio.github.handle}</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>{fullName}</span>
    <a class="text-link" href="#top">Back to top</a>
  </footer>

  <script>
    import '../scripts/site';
  </script>
</BaseLayout>
