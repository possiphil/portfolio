---
import { Image } from 'astro:assets';
import Sigil from '../components/studio/Sigil.astro';
import { site } from '../content/site';
import StudioLayout from '../layouts/StudioLayout.astro';

const { header, hero, about, reel, focus, education, projects, skills, profile, contact } = site;
const contactHref = contact.email ? `mailto:${contact.email}` : contact.primary.href;
const contactLabel = contact.email || contact.primary.label;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<StudioLayout>
  <div class="loader" data-loader aria-hidden="true"><span class="loader-dot"></span></div>
  <canvas class="gl-canvas" data-gl-canvas aria-hidden="true"></canvas>

  <header class="hd grid">
    <a class="hd-logo" href="#top" aria-label="Back to top"><Sigil /></a>
    <p class="hd-name label" data-hd-fade><span data-scramble>{site.name.first}</span><br /><span data-scramble>{site.name.last}</span></p>
    <p class="hd-tag label" data-hd-fade>{header.tagline.map((line, i) => <>{i > 0 && <br />}<span data-scramble>{line}</span></>)}</p>
    <a class="hd-cta label" href={header.cta.href} data-scramble-hover>{header.cta.label}</a>
  </header>

  <main id="top">
    <!-- /01 Hero -->
    <section class="hero grid" data-hero data-gl-atmos="hero">
      <h1 class="visually-hidden">{site.name.first} {site.name.last}</h1>
      <p class="hero-word giant" data-gl-text data-fit data-reveal="intro" aria-hidden="true">{site.heroWord}</p>
      <p class="hero-lines label">{hero.lines.map((line, i) => <>{i > 0 && <br />}<span data-scramble>{line}</span></>)}</p>
      <span class="hero-hint label">{hero.hint}</span>
      <span class="hero-index label">/01</span>
    </section>

    <!-- /02 About + reel -->
    <section class="about" id="about">
      <div class="row grid">
        <span class="label col-index" data-scramble-in>{about.index}</span>
        <span class="label col-name" data-scramble-in>{about.label}</span>
        <span class="label col-aside" data-scramble-in>{about.aside.map((line, i) => <>{i > 0 && <br />}{line}</>)}</span>
      </div>
      <p class="statement" data-words>{about.statement}</p>

      <div class="reel-wrap grid">
        <span class="label reel-label">{reel.label.map((line, i) => <>{i > 0 && <br />}{line}</>)}</span>
        <a class="reel" href={reel.link.href} target="_blank" rel="noopener" data-cursor={reel.link.label}>
          <figure class="reel-media" data-gl-media data-variant="crt">
            <Image src={reel.image.src} alt={reel.image.alt} widths={[800, 1400, 2000]} sizes="90vw" format="webp" quality={80} loading="eager" />
          </figure>
          <span class="reel-caption" data-type>{reel.caption.map((line, i) => <>{i > 0 && <br />}{line}</>)}</span>
          <span class="reel-play label"><span data-scramble-hover>{reel.link.label}</span></span>
        </a>
      </div>

      <div class="row focus grid">
        <span class="label col-index" data-scramble-in>{focus.index}</span>
        <span class="label col-name" data-scramble-in>{focus.label}</span>
        <div class="focus-copy">{focus.paragraphs.map((p) => <p data-lines>{p}</p>)}</div>
      </div>

      <div class="row edu grid">
        <span class="label col-name" data-scramble-in>{education.label}</span>
        <ul class="edu-list">
          {education.rows.map((row) => (
            <li class="edu-row" data-row>
              <span class="label">{row.title}</span>
              <span class="label edu-detail">{row.detail}</span>
              <span class="label edu-value">{row.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- /03 Projects -->
    <section class="projects" id="projects" aria-label={site.projectsLabel}>
      {projects.map((project, i) => (
        <article class="case" data-case>
          <div class="case-media" data-parallax {...(project.cover
            ? { 'data-gl-media': '' }
            : { 'data-gl-atmos': 'case', 'data-hue': project.hue ?? 190, style: `--hue:${project.hue ?? 190}` })}>
            {project.cover && <Image src={project.cover.src} alt={project.cover.alt} widths={[960, 1600, 2400]} sizes="100vw" format="webp" quality={80} />}
          </div>
          <h2 class="case-title giant" data-gl-text data-fit data-reveal="scroll">{project.title}</h2>
          <span class="case-index label">{pad(i)} / {pad(projects.length - 1)}</span>
          {project.thumbs && (
            <div class="case-thumbs" aria-hidden="true">
              {project.thumbs.map((thumb) => (
                <figure class="case-thumb" data-gl-media data-variant="thumb">
                  <Image src={thumb.src} alt="" widths={[240, 480]} sizes="12vw" format="webp" quality={70} />
                </figure>
              ))}
            </div>
          )}
          <div class="case-meta grid">
            <p class="label"><span class="dim">Type</span> {project.type}</p>
            <p class="label"><span class="dim">Year</span> {project.year}</p>
            <p class="label"><span class="dim">Stack</span> {project.stack}</p>
            {project.link && <a class="label case-link" href={project.link.href} data-scramble-hover>{project.link.label}</a>}
          </div>
        </article>
      ))}
    </section>

    <!-- /04 Skills -->
    <section class="skills" id="skills" data-gl-atmos="spot">
      <div class="row grid">
        <span class="label col-index" data-scramble-in>{skills.label}</span>
        <span class="label col-name" data-scramble-in>{skills.aside}</span>
        <span class="label col-end" data-scramble-in>{skills.index}</span>
      </div>
      <ul class="skills-list">
        {skills.items.map((item) => <li class="skill giant" data-gl-text data-fit-max="1.0" data-reveal="scroll" data-grain>{item}</li>)}
      </ul>
    </section>

    <!-- /05 Profile -->
    <section class="profile" id="profile">
      <div class="row grid">
        <span class="label col-index" data-scramble-in>{profile.index}</span>
        <span class="label col-name" data-scramble-in>{site.name.last}</span>
        <span class="label col-end" data-scramble-in>{profile.label}</span>
      </div>
      <p class="statement" data-words>{profile.statement}</p>
      <div class="profile-stage">
        <figure class="profile-media" data-gl-media data-variant="smear">
          <Image src={profile.portrait.src} alt={profile.portrait.alt} widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={80} />
        </figure>
        {profile.tags.map((tag, i) => <span class={`profile-tag label tag-${i}`} data-scramble-in>{tag}</span>)}
      </div>
    </section>

    <!-- /06 Contact -->
    <footer class="contact" id="contact">
      <div class="row grid">
        <span class="label col-index" data-scramble-in>{contact.index}</span>
        <span class="label col-name" data-scramble-in>{contact.label}</span>
        <span class="label col-end" data-scramble-in>{site.name.last}</span>
      </div>
      <p class="contact-lines" data-lines>{contact.lines.map((line) => <span>{line}</span>)}</p>
      <div class="contact-mail grid">
        <span class="contact-e">{contact.email ? 'E:' : '→'}</span>
        <a href={contactHref} data-underline>{contactLabel}</a>
      </div>
      <div class="contact-nav grid">
        <a class="contact-logo" href="#top" aria-label="Back to top"><Sigil /></a>
        <ul class="label">{contact.nav.map((item) => <li><a href={item.href} data-scramble-hover>{item.label}</a></li>)}</ul>
        <ul class="label">{contact.socials.map((item) => <li><a href={item.href} target="_blank" rel="noopener" data-scramble-hover>{item.label}</a></li>)}</ul>
      </div>
      <p class="footer-word giant" data-gl-text data-fit data-reveal="scroll" data-grain aria-hidden="true">{site.footerWord}</p>
      <div class="credits grid label">
        {contact.credits.map((c) => <span>{c}</span>)}
        <span>©{site.name.last} {new Date().getFullYear()}</span>
        <a href="#top" data-scramble-hover>Back to top</a>
      </div>
    </footer>
  </main>
</StudioLayout>
