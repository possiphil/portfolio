---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import WaveArt from '../components/WaveArt.astro';
import { media } from '../content/media';
import { categories, homeLinks, person, reel } from '../content/site';

const areas = ['a', 'b', 'c', 'd', 'e'];
---

<Base frame="fit">
  <h1 class="visually-hidden">{person.firstName} {person.lastName}, {person.role}</h1>
  <div class="home-grid">
    <Card href="/about" class="home-me" tilt={4.5} index={0} label="About me" tone="dark">
      <div class="me-photo" data-parallax="12">
        <Image src={media.portrait.image} alt="" widths={[420, 640, 900]} sizes="(min-width: 900px) 420px, 50vw" loading="eager" />
      </div>
      <div class="me-overlay" aria-hidden="true">
        {
          person.portraitOverlay.map((row, r) => (
            <span class="me-row">
              {[...row].map((ch, c) => (
                <span style={`--d:${r * 120 + c * 22}ms`}>{ch === ' ' ? ' ' : ch}</span>
              ))}
            </span>
          ))
        }
      </div>
      <span class="me-dot" aria-hidden="true"></span>
    </Card>

    {
      categories.slice(0, 5).map((category, i) => (
        <Card href={`/${category.slug}`} class={`home-tile area-${areas[i]}`} tilt={11} index={i + 1} label={category.title}>
          <div class="tile-art" data-parallax="11">
            <WaveArt palette={category.palette} variant={i} />
          </div>
          <span class="tile-label" style={`color:${category.palette.ink}`}>{category.label}</span>
        </Card>
      ))
    }

    <div class="home-divider" aria-hidden="true"><span></span></div>

    {
      homeLinks.map((pair, i) => (
        <Card class={`home-links links-${i + 1}`} tilt={6} index={6 + i}>
          <ul>
            {pair.map((link) => (
              <li>
                <a href={link.href} {...(link.href.startsWith('http') ? { rel: 'noopener', target: '_blank' } : {})}>
                  <strong>{link.title}</strong>
                  <span>{link.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </Card>
      ))
    }

    <Card class="home-reel" tilt={4} index={8} tone="dark">
      <div class="reel" data-reel>
        {
          reel.map((item, i) => (
            <a class:list={['reel-slide', { 'is-active': i === 0 }]} href={item.href} tabindex={i === 0 ? 0 : -1} aria-hidden={i === 0 ? undefined : 'true'}>
              <div class="reel-image" data-parallax="10">
                <Image src={item.media.image} alt={item.media.alt} widths={[480, 900]} sizes="(min-width: 900px) 440px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
              </div>
              <span class="reel-caption">
                <strong>{item.title}</strong>
                <span>{item.description}</span>
              </span>
            </a>
          ))
        }
        <span class="reel-dots" aria-hidden="true">
          {reel.map((_, i) => <span class:list={{ 'is-active': i === 0 }} />)}
        </span>
      </div>
    </Card>
  </div>
</Base>
