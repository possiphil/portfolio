---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import serifFont from '../assets/fonts/instrument-serif.woff2?url';
import GitHubMark from '../components/GitHubMark.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { fullName, portfolio, projects } from '../content/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

const navigation = [
  { id: 'top', label: 'Home' },
  { id: 'about', label: 'About' },
  { id: 'work', label: 'Projects' },
  { id: 'background', label: 'Education' },
  { id: 'contact', label: 'Contact' },
];
---

<BaseLayout intro>
  <link slot="preload" rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin="anonymous" />
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="header-inner shell">
      <a class="brand" href="#top">
        <span class="brand-mark" aria-hidden="true">{portfolio.initials}</span>
        <span>sanktjohanser.dev</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul role="list">
          {navigation.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Light mode" aria-pressed="false" data-theme-toggle hidden>
        <svg class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="7.5" />
          <path d="M12 4.5a7.5 7.5 0 0 1 0 15Z" fill="currentColor" stroke="none" />
        </svg>
      </button>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero shell" aria-labelledby="intro-heading">
      <div class="hero-stage">
        <div class="hero-identity">
          <p class="section-label hero-role">{portfolio.role}</p>
          <h1 class="hero-name" id="intro-heading">
            <span class="name-first"><span>{portfolio.firstName}</span></span>
            <span class="name-last"><span>{portfolio.lastName}</span></span>
          </h1>
        </div>
        <figure class="hero-portrait">
          <div class="portrait-aperture">
            <div class="portrait-plane">
              <Image
                src={portrait}
                alt={`Portrait of ${fullName}`}
                widths={[360, 560, 800, 1000]}
                sizes="(max-width: 51rem) calc(100vw - 2rem), 44vw"
                format="webp"
                quality={84}
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="portrait-shutter" data-initial={portfolio.lastName[0]} aria-hidden="true"></div>
          </div>
        </figure>
        <div class="hero-crease" aria-hidden="true"></div>

        <div class="hero-details">
          <p>{portfolio.introduction}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">View projects</a>
            <a class="text-link" href={portfolio.github.url}><GitHubMark /> GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-split shell about" id="about" aria-labelledby="about-heading" tabindex="-1">
      <p class="section-label">About</p>
      <div>
        <h2 class="display-heading" id="about-heading">{portfolio.about.heading}</h2>
        <div class="prose">
          {portfolio.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="section shell projects-section" id="work" aria-labelledby="work-heading" tabindex="-1">
      <h2 class="section-label" id="work-heading">Projects</h2>
      <div class="project-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="section section-split shell education" id="background" aria-labelledby="education-heading" tabindex="-1">
      <h2 class="section-label" id="education-heading">Education</h2>
      <div class="education-content">
        <ul class="education-list" role="list">
          {portfolio.education.map(({ degree, institutions, program, date, dateTime }) => (
            <li>
              <h3>{degree}</h3>
              <time datetime={dateTime}>{date}</time>
              <div class="education-description">
                {program && <p>{program}</p>}
                <p>{institutions}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="technical">
          <h3 class="section-label">Technical areas</h3>
          <dl class="details">
            {portfolio.technicalAreas.map(({ label, value }) => (
              <div><dt>{label}</dt><dd>{value}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="contact shell" id="contact" aria-labelledby="contact-heading" tabindex="-1">
      <div class="contact-panel">
        <div>
          <p class="section-label">Contact</p>
          <h2 class="display-heading" id="contact-heading">Find me on GitHub.</h2>
          <p>{portfolio.contact}</p>
        </div>
        <a class="button contact-button" href={portfolio.github.url}>
          <GitHubMark /><span>@{portfolio.github.handle}</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>{fullName}</span>
    <a class="text-link" href="#top">Back to top</a>
  </footer>

  <script>
    import '../scripts/site';
  </script>
</BaseLayout>
