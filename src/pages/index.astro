---
import { Image } from 'astro:assets';
import HoverPreview from '../components/variant/HoverPreview.astro';
import { fullName, home, projects, site } from '../content/variant';
import VariantLayout from '../layouts/VariantLayout.astro';

const words = home.intro.phrase.split(' ');
---

<VariantLayout title={`${fullName} • ${home.role.join(' ')}`} label="Home" active="home" navTone="light" footer="full" greet>
  <header class="hero" style={`--hero-color: ${home.heroColor}`} data-hero>
    <div class="hero-photo" data-hero-photo>
      <Image src={site.portrait} alt={site.portraitAlt} widths={[600, 900, 1000]} sizes="(max-width: 800px) 140vw, 70vw"
        format="webp" quality={86} loading="eager" fetchpriority="high" />
    </div>

    <div class="hanger">
      <p>{home.location.map((line) => <span>{line}</span>)}</p>
      <div class="hanger-globe" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2">
          <circle cx="16" cy="16" r="12" />
          <g class="globe-meridians">
            <ellipse cx="16" cy="16" rx="5.5" ry="12" />
            <path d="M16 4v24" />
          </g>
          <path d="M4.6 12h22.8M4.6 20h22.8" />
        </svg>
      </div>
    </div>

    <div class="hero-role" data-hero-parallax>
      <svg class="hero-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M6 6l12 12M18 8v10H8" /></svg>
      <h2>{home.role.map((line) => <span>{line}</span>)}</h2>
    </div>

    <div class="hero-name-wrap" aria-hidden="true">
      <div class="hero-name-track" data-marquee>
        <span>{fullName}<i>—</i></span>
        <span>{fullName}<i>—</i></span>
      </div>
    </div>
    <h1 class="visually-hidden">{fullName}</h1>
  </header>

  <main>
    <section class="intro container-medium">
      <div class="intro-grid">
        <h3 class="intro-phrase" data-reveal-words aria-label={home.intro.phrase}>
          {words.map((word, index) => (
            <span class="word-mask" aria-hidden="true"><span style={`--i: ${index}`}>{word}</span></span>
          ))}
        </h3>
        <div class="intro-side">
          <p data-fade>{home.intro.paragraph}</p>
          <div class="intro-button" data-parallax-button>
            <a class="round-button magnetic" href="/about" data-magnetic>
              <span class="btn-fill"></span>
              <span class="magnetic-inner">{home.intro.button}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="home-work container-medium" data-hover-scope>
      <p class="eyebrow">Recent work</p>
      <ul class="home-work-list">
        {projects.map((project, index) => (
          <li class="home-work-row hover-row" data-hover-row={index} data-label="View">
            <a href={`/work/${project.slug}`}>
              <h4>{project.title}</h4>
              <p>{project.services}</p>
            </a>
          </li>
        ))}
      </ul>

      <ul class="work-tiles home-work-tiles">
        {projects.map((project) => (
          <li>
            <a class="work-tile" href={`/work/${project.slug}`}>
              <div class="work-tile-media" style={`background-color: ${project.color}`}>
                {project.image
                  ? <Image src={project.image} alt={project.alt ?? project.title} widths={[480, 800]} sizes="90vw" format="webp" />
                  : <span class="placeholder-title">{project.title}</span>}
              </div>
              <h4>{project.title}</h4>
              <span class="stripe"></span>
              <div class="work-tile-meta"><p>{project.services}</p><p>{project.year}</p></div>
            </a>
          </li>
        ))}
      </ul>

      <div class="center-button">
        <a class="pill-button magnetic" href="/work" data-magnetic>
          <span class="btn-fill"></span>
          <span class="magnetic-inner">{home.moreWork}<sup>{projects.length}</sup></span>
        </a>
      </div>

      <HoverPreview items={projects} />
    </section>
  </main>
</VariantLayout>
