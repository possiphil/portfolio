---
import sansFont from '../assets/fonts/instrument-sans.woff2?url';
import { fullName, portfolio } from '../content/portfolio';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  notFound?: boolean;
  intro?: boolean;
}

const {
  title = `${fullName} | ${portfolio.role}`,
  description = portfolio.description,
  notFound = false,
  intro = false,
} = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
const socialImage = Astro.site && new URL('/social-card.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#17171c" />
    <script define:vars={{ intro }}>
      const root = document.documentElement;

      // Restore the palette before the stylesheet or page can paint.
      try {
        if (localStorage.getItem('portfolio-theme') === 'light') {
          root.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]').content = '#f5f3ee';
        }
      } catch {
        // The default palette also works when storage is unavailable.
      }

      if (intro && !location.hash && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        try {
          if (!localStorage.getItem('portfolio-portrait-intro')) {
            localStorage.setItem('portfolio-portrait-intro', 'seen');
            root.dataset.intro = '';
          }
        } catch {
          // Show the steady-state hero when repeat visits cannot be detected.
        }
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <slot name="preload" />
    {notFound ? <meta name="robots" content="noindex" /> : (
      <>
        {canonical && <link rel="canonical" href={canonical} />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={fullName} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {canonical && <meta property="og:url" content={canonical} />}
        {socialImage && (
          <>
            <meta property="og:image" content={socialImage} />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta property="og:image:alt" content={`${fullName}, ${portfolio.role}, with a monochrome portrait.`} />
          </>
        )}
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
