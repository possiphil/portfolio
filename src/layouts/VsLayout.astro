---
import sansFont from '../assets/fonts/instrument-sans.woff2?url';
import { site } from '../content/cv';
import '../styles/vs.css';

interface Props {
  title?: string;
}

const { title = site.title } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = Astro.site && new URL(pathname, Astro.site).href;
const socialImage = Astro.site && new URL('/social-card.jpg', Astro.site).href;
---

<!doctype html>
<html lang="en" class="vs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin="anonymous" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('is-js');
        if ('ontouchstart' in window || navigator.maxTouchPoints > 0) root.classList.add('is-touch');
        const brands = navigator.userAgentData && navigator.userAgentData.brands;
        if (brands && brands.some((b) => /Chromium/.test(b.brand))) root.classList.add('is-chromium');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('is-reduced');
        try {
          if (sessionStorage.getItem('vs-loaded')) root.classList.add('is-returning');
        } catch {
          // The loader simply plays again without storage.
        }
      })();
    </script>
    <noscript><style>.loader { display: none !important; }</style></noscript>
  </head>
  <body>
    <slot />
  </body>
</html>
